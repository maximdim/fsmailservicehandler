<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.maximdim</groupId>
  <artifactId>fsmailservicehandler</artifactId>
  <version>0.0.5</version>

  <properties>
    <java.version>1.8</java.version>
    <!-- keep in step with what mjb1 actually loads: solr-home/gmail2/lib for jsoup and this jar,
         solr-4.10.2/contrib/dataimporthandler-extras/lib for javax.mail -->
    <solr.version>4.10.2</solr.version>
    <mail.version>1.5.1</mail.version>
    <!-- the version blp2 ships; 1.23.x still runs on Java 8 -->
    <jsoup.version>1.23.2</jsoup.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>2.3.2</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
      </plugin>
      <!-- target/lib: the runtime jars mjb1 does not already provide (solr and javax.mail are
           provided), which the release workflow attaches next to this jar -->
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.apache.solr</groupId>
      <artifactId>solr-dataimporthandler</artifactId>
      <version>${solr.version}</version>
      <scope>provided</scope>
      <exclusions>
        <!-- pulled in via solr-core, and only published on a plain-HTTP repo that Maven now
             blocks. We compile against the DIH API alone, so none of it is needed. -->
        <exclusion>
          <groupId>org.restlet.jee</groupId>
          <artifactId>org.restlet</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.restlet.jee</groupId>
          <artifactId>org.restlet.ext.servlet</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- provided by Jetty's lib/mail on mjb1, so not shipped with the release -->
    <dependency>
      <groupId>com.sun.mail</groupId>
      <artifactId>javax.mail</artifactId>
      <version>${mail.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- HTML bodies to text. Tika is gone: attachments are no longer opened, and plain text needs
         no parser. -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>${jsoup.version}</version>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.8</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
